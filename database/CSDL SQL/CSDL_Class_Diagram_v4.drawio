ell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="2116.0" width="1040.0" height="166.0" as="geometry"/></mxCell><mxCell id="legend.0" value="Chú thích" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=1;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="10.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.1" value='Thuộc tính "-" = private; {PK} khoá chính; {GEN} cột sinh (STORED, chỉ đọc). Cột FK không lặp lại thành thuộc tính mà được thể hiện bằng association.' style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="31.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.2" value="Mũi tên mở = association một chiều (lớp con giữ tham chiếu tới lớp cha); bội số ghi ở hai đầu, tên vai trò ghi cạnh lớp được tham chiếu; {CASCADE} = ON DELETE CASCADE." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="52.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.3" value="Mũi tên nét đứt = tham chiếu logic bằng id, không có khoá ngoại vật lý (AuthAuditLog)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="73.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.4" value='Ô nét đứt "→ X" = association tới lớp ở nhóm khác, vẽ rút gọn để tránh đường chéo (13 đầu nối). Lớp viền nét đứt = module thực nghiệm (tùy chọn).' style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="94.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.5" value="Kiểu Java: bigint→Long, bit→Boolean, datetime(6)→Instant (UTC), date→LocalDate, json→JsonNode, varbinary→byte[], decimal→BigDecimal, enum→enum Java." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="115.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.6" value="Cột NOT NULL dùng kiểu nguyên thủy (int, long, boolean); cột cho phép NULL và khoá chính dùng kiểu bao (Integer, Long, Boolean)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="136.0" width="1028.0" height="21.0" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#000000;strokeW