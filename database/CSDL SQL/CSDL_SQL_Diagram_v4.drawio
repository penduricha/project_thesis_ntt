0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="10.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.1" value="PK: khoá chính  |  FK: khoá ngoại  |  UQ: duy nhất  |  GEN: cột sinh (STORED)  |  AI: AUTO_INCREMENT" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="31.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.2" value="Null: Y = cho phép NULL, N = NOT NULL" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="52.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.3" value="Đầu đường nối: một vạch = phía một (bảng cha, PK); chân chim = phía nhiều (bảng con, FK); vòng tròn + vạch = 0..1 (FK cho phép NULL)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="73.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.4" value="Tên khoá ngoại ghi trên đường nối; FK ghép ghi trong ngoặc: (cột_1, cột_2) – ép bản ghi con và cha cùng phạm vi (môn, câu hỏi, split DEV/TEST)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="94.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.5" value='Ô nét đứt "→ ntt_x" = FK tới bảng ở nhóm khác, vẽ rút gọn để tránh đường chéo (13 đầu nối). Bảng viền nét đứt = module thực nghiệm (tùy chọn).' style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="115.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.6" value="Toàn bộ 38 quan hệ: 7 (bảng cũ) + 18 đường nối + 13 đầu nối. Không có ALTER nào lên 7 bảng cũ." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="136.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.7" value="Cột sinh (STORED) mô phỏng UNIQUE có điều kiện: parent_key, active_flag, default_key, annotator_key." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fontStyle=0;rounded=0;" vertex="1" parent="legend"><mxGeometry x="12.0" y="157.0" width="868.0" height="21.0" as="geometry"/></mxCell><mxCell id="legend.8" value="Mọi datetime(6) lưu UTC. Mọi bảng ENGINE=InnoDB, utf8mb4. ON DELETE RESTRICT, trừ 2 CASCADE (suggestions→tasks, items→exchanges)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=