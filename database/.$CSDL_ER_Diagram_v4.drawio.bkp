<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="er4" name="CSDL_v4">
    <mxGraphModel dx="6068" dy="3305" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4920" pageHeight="2602" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dDmhOTp-GQjVJ3sFvf9n-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="2506" width="4880" x="-40" y="-116" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Sơ đồ CSDL v4 – Hệ thống ngân hàng câu hỏi trắc nghiệm tích hợp Moodle (MariaDB ≥ 10.6)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="2400" x="40" y="-112" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="&lt;font color=&quot;#333333&quot;&gt;Nền trắng. Xanh dương = 7 bảng xác thực/tổ chức ĐÃ CÓ, GIỮ NGUYÊN 100%. Xanh lá = 12 bảng nghiệp vụ mới. Cam nét đứt = module thực nghiệm (Chương 4.3, tùy chọn).&lt;/font&gt;" vertex="1">
          <mxGeometry height="22" width="3200" x="40" y="-78" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;" value="" vertex="1">
          <mxGeometry height="180" width="940" x="420" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="legend_text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; khóa chính   &lt;/font&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; khóa ngoại   &lt;/font&gt;&lt;font color=&quot;#7E22CE&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; duy nhất   &lt;/font&gt;&lt;font color=&quot;#0F766E&quot;&gt;&lt;b&gt;GEN&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; cột sinh (STORED)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Đầu &lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;chân chim&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; = phía &quot;nhiều&quot; (bảng giữ FK); đầu &lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;gạch&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; = phía &quot;một&quot; (bảng cha); &lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;vòng tròn + gạch&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; = FK cho phép NULL.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4C6FA5&quot;&gt;&lt;b&gt;━ &lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;FK của 7 bảng cũ (không đổi)   &lt;/font&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;━ &lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;FK nghiệp vụ mới   &lt;/font&gt;&lt;font color=&quot;#D79B00&quot;&gt;&lt;b&gt;╌ &lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;module thực nghiệm (tùy chọn)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Ô nét đứt &quot;→ ntt_x&quot;&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt; = FK tới bảng ở nhóm khác, vẽ rút gọn để tránh đường chéo (13 đầu nối).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Toàn bộ 38 quan hệ: 7 (bảng cũ) + 18 đường nối + 13 đầu nối. Không có ALTER nào lên 7 bảng cũ.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;FK ghép &lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;(ghi trong ngoặc trên đường nối) ép bản ghi con và cha cùng phạm vi: cùng môn (topics, questions),&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;cùng câu hỏi (tasks, items → revisions), cùng split DEV/TEST (eval_items, eval_predictions).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Cột sinh (STORED) mô phỏng UNIQUE có điều kiện: parent_key, active_flag, default_key, annotator_key.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Mọi datetime(6) lưu UTC. Mọi bảng ENGINE=InnoDB, utf8mb4. ON DELETE RESTRICT, trừ 2 CASCADE (suggestions→tasks, items→exchanges).&lt;/font&gt;" vertex="1">
          <mxGeometry height="162" width="920" x="430" y="1278" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;" value="" vertex="1">
          <mxGeometry height="150" width="520" x="4060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="notes_text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="&lt;font color=&quot;#000000&quot;&gt;1. FK ghép (subject_id, parent_id) cho ntt_topics; (split, injected_from_item_id) cho ntt_eval_items.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;2. Điền biểu thức cho các cột sinh; thêm default_key (profiles) và annotator_key (labels).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;3. CHECK: difficulty 1..5, chuỗi không trắng, attempt_count, quyết định AI, phạm vi task.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;4. Trigger: đổi nội dung → câu hỏi &quot;stale&quot;, đề xuất AI liên quan &quot;stale&quot;.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;5. eval_predictions thêm split + FK ghép (chống lẫn DEV/TEST giữa run và item).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;6. issue_types thêm giá trị &quot;none&quot; để biết người gán đã duyệt mẫu &quot;không lỗi&quot;.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;7. Điền đầy đủ các enum trước đây ghi &quot;...&quot; (status, change_source, scenario, target_field).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;8. content_hash: chỉ INDEX (không UNIQUE) → cảnh báo trùng trong cùng môn, không chặn cứng.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;9. FULLTEXT (stem, option_a..d) + INDEX (subject_id, topic_id, status) cho UC05/UC06.&lt;/font&gt;" vertex="1">
          <mxGeometry height="132" width="500" x="4070" y="68" as="geometry" />
        </mxCell>
