" as="geometry"/></mxCell><mxCell id="c152" value="issueType" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2282.7" y="3125.5" width="64.5" height="21" as="geometry"/></mxCell><mxCell id="c153" value="0..*" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2268" y="3136.5" width="25.5" height="21" as="geometry"/></mxCell><mxCell id="c154" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2342" y="3136.5" width="20" height="21" as="geometry"/></mxCell><mxCell id="c155" value="0..*" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1618.0" y="2907.5" width="25.5" height="21" as="geometry"/></mxCell><mxCell id="c156" value="issueType" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1618.0" y="2941.5" width="64.5" height="21" as="geometry"/></mxCell><mxCell id="c157" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1618.0" y="2975.5" width="20" height="21" as="geometry"/></mxCell><mxCell id="c158" value="Sơ đồ Class (Java / JPA) – Hệ thống ngân hàng câu hỏi trắc nghiệm tích hợp kiểm định AI và Moodle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#000000;spacing=0;whiteSpace=nowrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="832.2" y="14.0" width="962.5" height="28" as="geometry"/></mxCell><mxCell id="c159" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;Mũi tên mở: association một chiều, từ lớp giữ tham chiếu (cột FK) tới lớp được tham chiếu.&lt;br&gt;Nhãn ở đầu mũi tên: bội số và tên thuộc tính tham chiếu (vai trò); đầu kia: bội số phía lớp con.&lt;br&gt;Cột FK không liệt kê trong thuộc tính vì đã thể hiện bằng association.&lt;br&gt;Nét đứt AuthAuditLog: tham chiếu logic qua adminId, deviceId, không có FK vật lý.&lt;br&gt;Ô nét đứt “→ X”: association tới lớp ở nhóm khác, vẽ rút gọn (13 đầu nối).&lt;br&gt;Lớp viền nét đứt: module thực nghiệm (tùy chọn).&lt;br&gt;{PK} khoá chính | {generated} cột sinh, chỉ đọc | {version} @Version (khoá lạc quan).&lt;br&gt;FK ghép (cùng môn, cùng câu hỏi, cùng split DEV/TEST) được ép ở tầng CSDL." style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="524.18359375" height="178" as="geometry"/></mxCell><mxCell id="c160" value="&lt;b&gt;Ánh xạ kiểu SQL → Java&lt;/b&gt;&lt;br&gt;bigint → Long | int → Integer | tinyint → Byte | smallint → Short&lt;br&gt;bit(1) → Boolean | varchar, char, text, longtext → String&lt;br&gt;datetime(6) → Instant (UTC) | date → LocalDate&lt;br&gt;decimal(6,3) → BigDecimal | json → JsonNode (Jackson)&lt;br&gt;varbinary → byte[] | enum → Java enum (xem bảng bên dưới)" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="278" width="358.2578125" height="124" as="geometry"/></mxCell><mxCell id="c161" value="&lt;b&gt;Enumerations&lt;/b&gt;&lt;br&gt;AccountStatus { active, disabled, locked, pending }&lt;br&gt;AiTaskStatus { pending, running, succeeded, failed, cancelled }&lt;br&gt;AiTaskType { question_check, nl_search }&lt;br&gt;AnswerLabel { A, B, C, D }&lt;br&gt;AnswerNumbering { none, abc, ABCD, 123 }&lt;br&gt;AuthEvent { 19 giá trị }&lt;br&gt;ChangeSource { create, manual, ai_suggestion, moodle_import, archive, restore }&lt;br&gt;ContentFormat { plain, html }&lt;br&gt;DevicePlatform { android, ios }&lt;br&gt;DeviceStatus { active, pending, revoked }&lt;br&gt;EvalMethod { rule_based, llm }&lt;br&gt;EvalScenario { E1, E2, E3, E4, E5, E6, E7, E8 }&lt;br&gt;EvalSplit { dev, test }&lt;br&gt;ExchangeDirection { export, import }&lt;br&gt;ExchangeItemStatus { ok, skipped, failed }&lt;br&gt;ExchangeStatus { pending, succeeded, partial, failed }&lt;br&gt;GoldStatus { unlabeled, clean, has_errors }&lt;br&gt;ItemOrigin { real, injected }&lt;br&gt;LabelStage { annotator, gold }&lt;br&gt;MoodleCheck { unknown, ok, failed }&lt;br&gt;QuestionSource { manual, moodle_import, eval }&lt;br&gt;QuestionStatus { active, archived }&lt;br&gt;SessionStatus { active, expired, logged_out, revoked }&lt;br&gt;Severity { low, medium, high }&lt;br&gt;SuggestionDecision { pending, accepted, rejected, stale }&lt;br&gt;TargetField { question, stem, option_a, option_b, option_c, option_d }&lt;br&gt;UserRole { admin, lecturer }&lt;br&gt;ValidationStatus { not_checked, clean, has_issues, failed, stale }" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2010" y="1496" width="457.69921875" height="538" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>