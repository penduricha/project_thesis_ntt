<mxCell id="c74" value="created_by" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1998" y="1488.5" width="60.4" height="19" as="geometry"/></mxCell><mxCell id="c75" value="decided_by" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2483.9" y="2577.5" width="62.3" height="19" as="geometry"/></mxCell><mxCell id="c76" value="created_by" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="194.8" y="3327.5" width="60.4" height="19" as="geometry"/></mxCell><mxCell id="c77" value="created_by" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="194.8" y="2891.5" width="60.4" height="19" as="geometry"/></mxCell><mxCell id="c78" value="created_by" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="924.8" y="3291.5" width="60.4" height="19" as="geometry"/></mxCell><mxCell id="c79" value="eval_run_id" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2443.6" y="2059.5" width="62.9" height="19" as="geometry"/></mxCell><mxCell id="c80" value="question_id" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="193.9" y="2351.5" width="62.3" height="19" as="geometry"/></mxCell><mxCell id="c81" value="question_id" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2828" y="2900.5" width="62.3" height="19" as="geometry"/></mxCell><mxCell id="c82" value="issue_type" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="3085.7" y="3479.5" width="58.6" height="19" as="geometry"/></mxCell><mxCell id="c83" value="issue_type" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;spacing=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2082.0" y="3184.5" width="58.6" height="19" as="geometry"/></mxCell><mxCell id="c84" value="Sơ đồ CSDL (SQL) – Hệ thống ngân hàng câu hỏi trắc nghiệm tích hợp kiểm định AI và Moodle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#000000;spacing=0;whiteSpace=nowrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1252.1" y="14.0" width="905.8" height="28" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;PK: khoá chính | FK: khoá ngoại | UQ: duy nhất | AI: AUTO_INCREMENT | GEN: cột sinh (STORED)&lt;br&gt;Null: Y = cho phép NULL, N = NOT NULL.  CHK: ràng buộc CHECK | IX: chỉ mục | TRG: trigger&lt;br&gt;Đầu đường nối: một vạch = phía một (bảng cha, PK); chân chim = phía nhiều (bảng con, FK);&lt;br&gt;vòng tròn + vạch = 0..1 (FK cho phép NULL hoặc quan hệ một–một). Tên khoá ngoại ghi trên đường nối;&lt;br&gt;FK ghép ghi các cột trong ngoặc, ép bản ghi con và cha cùng phạm vi (cùng môn, cùng câu hỏi, cùng split DEV/TEST).&lt;br&gt;Ô nét đứt “→ ntt_x” = FK tới bảng ở nhóm khác, vẽ rút gọn để tránh đường chéo (13 đầu nối).&lt;br&gt;Bảng và đường nét đứt = module thực nghiệm (tùy chọn). Toàn bộ 38 quan hệ: 7 (bảng cũ) + 18 đường nối + 13 đầu nối.&lt;br&gt;Mọi bảng ENGINE=InnoDB, utf8mb4; datetime(6) lưu UTC; ON DELETE RESTRICT, trừ 2 CASCADE (suggestions → tasks, items → exchanges)." style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="70" width="803.51953125" height="189" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>