# Sao chép thành .env và điền giá trị thật (không commit .env lên Git)

SPRING_BOOT_PORT=8082
IP_ADDRESS=127.0.0.1
MARIADB_PORT=3306
MARIADB_DBS=ntt_demo_llm
MARIADB_USERNAME=root
MARIADB_PASSWORD=

REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DBS=0

# Hibernate DDL: "update" khi chạy độc lập trên ntt_demo_llm; đặt "validate" khi ghép vào DB chính ER v4
JPA_DDL_AUTO=update
AI_DEMO_SEED_ISSUE_TYPES=true
AI_DEMO_CREATED_BY=1
AI_DEMO_EVAL_CONCURRENCY=10

# Bảo mật API /web/ai/** (bắt buộc ít nhất một khóa khi chạy ngoài profile dev/test/local)
# JWT_SECRET dùng chung khóa >= 32 ký tự với be-web-admin (tạo bằng: openssl rand -base64 48)
JWT_SECRET=
AI_INTERNAL_TOKEN=
AI_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082

# Khai báo node Colab (có thể cấu hình động qua trang /api/node-colab.html thay vì ghi vào file)
AI_NODE_1_URL=
AI_NODE_1_TOKEN=
AI_NODE_1_ENABLED=true
