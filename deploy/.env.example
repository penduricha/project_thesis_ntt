# =============================================================================
#  Biến môi trường cho Docker Compose
# =============================================================================
#  CÁCH DÙNG:
#      cp deploy/.env.example deploy/.env
#      # rồi điền các giá trị BẮT BUỘC bên dưới
#
#  File .env đã bị .gitignore — KHÔNG commit lên Git.
#
#  Dấu ${VAR:?thông báo} trong docker-compose.yml nghĩa là: biến này KHÔNG
#  có giá trị thì Compose DỪNG NGAY với thông báo đó. Đây là cố ý — thà
#  không khởi động được còn hơn chạy production với khóa rỗng.
# =============================================================================

# -----------------------------------------------------------------------------
# MẬT KHẨU CSDL — BẮT BUỘC
# -----------------------------------------------------------------------------
# Tạo bằng:  openssl rand -base64 24
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Tên user và database (có thể giữ mặc định)
MARIADB_USERNAME=ntt
MARIADB_DBS=ntt_thesis
AI_MARIADB_DBS=ntt_demo_llm
MOODLE_DB_NAME=moodle_local

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Để trống nếu chấp nhận Redis không mật khẩu. Redis chỉ nằm trong mạng nội
# bộ (mạng "data" có internal: true, không có đường ra Internet) nên rủi ro
# thấp, nhưng nên đặt mật khẩu nếu có thời gian.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# BẢO MẬT ỨNG DỤNG — BẮT BUỘC
# -----------------------------------------------------------------------------
# JWT_SECRET: >= 32 ký tự. Tạo bằng:  openssl rand -base64 48
# Ứng dụng SẼ KHÔNG KHỞI ĐỘNG nếu dùng khóa mặc định ở môi trường không phải
# dev/local (xem security/JwtSecretGuard.java). Đây là hành vi có chủ đích.
JWT_SECRET=

# TOTP_MASTER_KEY_V2: Base64 của ĐÚNG 32 byte. Tạo bằng:  openssl rand -base64 32
# Dùng để mã hóa secret 2FA của admin. Mất khóa này = mất toàn bộ 2FA.
TOTP_MASTER_KEY_V2=

# Chỉ dùng một lần khi di chuyển dữ liệu 2FA cũ. Để trống sau khi xong.
TOTP_LEGACY_MASTER_SECRET=

# Token nội bộ giữa be-web-admin và ai-worker. Tạo bằng:  openssl rand -base64 32
# PHẢI trùng ở CẢ HAI service — compose tự truyền cùng giá trị cho cả hai.
AI_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# SEED DỮ LIỆU MẪU (lần chạy đầu)
# -----------------------------------------------------------------------------
# true: nạp 2 khoá học + 10 admin + 5 môn × 100 câu hỏi.
# Chỉ có tác dụng khi bảng còn trống (idempotent), nên để true cũng an toàn.
# Đặt false sau khi đã có dữ liệu thật.
APP_SEED_ENABLED=true
APP_SEED_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# DOMAIN — đổi nếu dùng tên miền khác trong file hosts
# -----------------------------------------------------------------------------
# Danh sách origin được phép gọi API.
# QUAN TRỌNG: phải GHI KÈM CỔNG, vì trình duyệt gửi Origin kèm cổng khi cổng
# khác 80. Ghi "http://qbank.local" (thiếu :5176) thì CORS CHẶN toàn bộ API
# và rất khó đoán ra nguyên nhân (log backend chỉ ghi "403 Forbidden").
# 5176 = QBank Console, 8085 = fe_web_admin — khớp bảng cổng trong README.
APP_CORS_ALLOWED_ORIGINS=http://qbank.local:5176,http://admin.local:8085,http://localhost:5176,http://127.0.0.1:5176,http://localhost:8085,http://127.0.0.1:8085

# wwwroot của Moodle. PHẢI khớp CHÍNH XÁC URL người dùng mở trên trình duyệt
# — KỂ CẢ CỔNG. Mở http://moodle.local:9000 thì wwwroot cũng phải có ":9000".
# Moodle lưu giá trị này vào CSDL lúc cài; lệch là hiện "Site not found"
# hoặc chuyển hướng vòng vô tận.
MOODLE_WWWROOT=http://moodle.local:9000

# UID/GID của user sở hữu thư mục Moodle trên host.
# LẤY SỐ ĐÚNG BẰNG:  stat -c '%u %g' php_moodle_503/moodle-latest-503/moodle
# (repo này hiện là 1001 1001; máy Linux khác thường là 1000 1000)
# Nếu sai, container không ghi được cache theme -> Moodle mất CSS.
# Trên macOS/Windows: giữ mặc định, Docker Desktop tự ánh xạ quyền.
MOODLE_UID=1001
MOODLE_GID=1001

# -----------------------------------------------------------------------------
# AI WORKER → Colab/Ollama (không bắt buộc)
# -----------------------------------------------------------------------------
# Để trống nếu chưa có máy chạy LLM. Khi trống, nút "Kiểm định AI" trả lỗi
# rõ ràng thay vì tạo task treo vĩnh viễn.
AI_NODE_1_URL=
AI_NODE_1_TOKEN=
AI_NODE_1_ENABLED=false

# -----------------------------------------------------------------------------
# JPA DDL (nâng cao)
# -----------------------------------------------------------------------------
# update: Hibernate tự tạo/sửa bảng, tiện cho đồ án.
# validate: chỉ kiểm tra, không sửa — dùng khi CSDL đã chốt và chạy script SQL.
JPA_DDL_AUTO=update
AI_JPA_DDL_AUTO=update
