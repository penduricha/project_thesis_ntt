# Sao chép thành .env khi chạy local (không commit .env).
# Ưu tiên VITE_API_BASE_URL nếu muốn ghi đè toàn bộ base URL.
# VITE_API_BASE_URL=http://localhost:8080/api/web
# VITE_API_BASE_URL=/api/web

# Spring Boot (be-web-admin): context-path /api + /web/admin => /api/web/admin/...
VITE_SPRING_PROTOCOL=http
VITE_SPRING_HOST=localhost
VITE_SPRING_PORT=8080
VITE_SPRING_API_PREFIX=/api/web

VITE_REQUEST_TIMEOUT_MS=15000

# Demo mode: CHỈ để xem UI khi chưa có Spring Boot/MariaDB/Redis.
# true = đăng nhập bằng bất kỳ mã/mật khẩu nào + dùng dữ liệu mẫu (không gọi backend).
# Production / chạy thật với backend phải để false.
VITE_DEMO_MODE=false
