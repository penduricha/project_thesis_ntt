{
  "name": "qbank-console-vue3",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "node tools/check-build-syntax.mjs src/",
    "test:login": "node tools/check-login-submit.mjs && node tools/check-auth-errors.mjs",
    "test:course-import": "node tools/check-course-import.mjs && node tools/check-course-import-ui.mjs",
    "fix:syntax": "node tools/check-build-syntax.mjs --fix src/",
    "test:crud-lifecycle": "node tools/check-crud-lifecycle.mjs",
    "test:subject-crud": "node tools/check-subject-crud.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.1",
    "read-excel-file": "^9.3.20",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "jsdom": "^26.1.0",
    "vite": "^8.3.8"
  }
