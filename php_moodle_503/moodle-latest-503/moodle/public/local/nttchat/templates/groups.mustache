{{!
    @template local_nttchat/groups

    Khung trang "Nhóm chat". Danh sách nhóm do JS (local_nttchat/groups) dựng vào [data-region="groups"].

    Example context (json):
    {}
}}
<div class="local-nttchat" data-region="nttchat-page">
    <p class="text-muted">{{#str}}pageintro, local_nttchat{{/str}}</p>

    <div data-region="alerts" aria-live="polite"></div>

    <section class="card mb-4" data-region="direct">
        <div class="card-body">
            <h2 class="h5">{{#str}}directmessage, local_nttchat{{/str}}</h2>
            <p class="text-muted small mb-2">{{#str}}directmessagehelp, local_nttchat{{/str}}</p>
            <label class="visually-hidden" for="nttchat-direct-search">{{#str}}directmessage, local_nttchat{{/str}}</label>
            <input type="search" id="nttchat-direct-search" class="form-control" autocomplete="off"
                   data-region="search-input" data-search="direct"
                   placeholder="{{#str}}searchplaceholder, local_nttchat{{/str}}">
            <ul class="list-unstyled mt-2 mb-0" data-region="search-results" aria-live="polite"></ul>
        </div>
    </section>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0">{{#str}}yourgroups, local_nttchat{{/str}}</h2>
        <button type="button" class="btn btn-primary" data-action="toggle-create" aria-expanded="false">
            {{#str}}creategroup, local_nttchat{{/str}}
        </button>
    </div>

    <section class="card mb-4 d-none" data-region="create">
        <div class="card-body">
            <h3 class="h6">{{#str}}newgroup, local_nttchat{{/str}}</h3>
            <div class="mb-3">
                <label class="form-label" for="nttchat-create-name">{{#str}}groupname, local_nttchat{{/str}}</label>
                <input type="text" id="nttchat-create-name" class="form-control" maxlength="100" autocomplete="off"
                       data-region="create-name" placeholder="{{#str}}groupnameplaceholder, local_nttchat{{/str}}">
            </div>
            <div class="mb-3">
                <label class="form-label" for="nttchat-create-search">{{#str}}searchmembers, local_nttchat{{/str}}</label>
                <input type="search" id="nttchat-create-search" class="form-control" autocomplete="off"
                       data-region="search-input" data-search="create"
                       placeholder="{{#str}}searchplaceholder, local_nttchat{{/str}}">
                <ul class="list-unstyled mt-2 mb-0" data-region="search-results" aria-live="polite"></ul>
            </div>
            <div class="mb-3">
                <div class="form-label">{{#str}}selectedmembers, local_nttchat{{/str}}</div>
                <div class="d-flex flex-wrap gap-2" data-region="selected" aria-live="polite"></div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" data-action="submit-create">{{#str}}creategroup, local_nttchat{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-action="toggle-create">{{#str}}cancel, local_nttchat{{/str}}</button>
            </div>
        </div>
    </section>

    <div data-region="groups"></div>
    <p class="text-muted d-none" data-region="empty">{{#str}}nogroups, local_nttchat{{/str}}</p>
</div>
