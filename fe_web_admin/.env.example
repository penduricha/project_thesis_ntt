# Sao chép thành .env khi cần ghi đè cấu hình mặc định ở local (không commit .env lên Git)

# ===== Spring Boot =====
VITE_SPRING_PROTOCOL=http
VITE_SPRING_HOST=localhost
VITE_SPRING_PORT=8080
VITE_SPRING_API_PREFIX=/api/web

# ===== Node.js =====
VITE_NODEJS_PROTOCOL=http
VITE_NODEJS_HOST=localhost
VITE_NODEJS_PORT=3000
VITE_NODEJS_API_PREFIX=/api/web

# ===== Thời gian chờ (mili giây) =====
VITE_REQUEST_TIMEOUT_MS=15000
