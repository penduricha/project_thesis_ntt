# ===================== CẤU HÌNH MẪU cho be-web-admin =====================
# Sao chép file này thành .env (đã bị .gitignore, KHÔNG commit) rồi điền giá trị thật.
# Spring Boot đọc file này nhờ: spring.config.import = optional:file:.env[.properties]

# ---------- Hạ tầng ----------
IP_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DBS=0
MARIADB_PORT=3306
MARIADB_DBS=ntt_thesis
MARIADB_USERNAME=ntt
MARIADB_PASSWORD=

# ---------- Khóa mã hóa TOTP ----------
# Base64 của 32 byte ngẫu nhiên:  openssl rand -base64 32
TOTP_MASTER_KEY_V2=
# Chỉ dùng một lần khi di chuyển dữ liệu cũ; để trống sau khi xong.
TOTP_LEGACY_MASTER_SECRET=

# ---------- JWT ----------
# BẮT BUỘC khi chạy thật. >= 32 ký tự.  openssl rand -base64 48
# Trước đây khóa này hard-code trong AdminJwtTokenProvider (ai đọc repo cũng tự ký được token ADMIN).
# Ứng dụng SẼ KHÔNG KHỞI ĐỘNG nếu vẫn dùng khóa mặc định mà profile không phải dev/test/local
# (xem security/JwtSecretGuard.java).
JWT_SECRET=

# ---------- CORS (web quản trị) ----------
# Nhiều origin thì phân tách bằng dấu phẩy. Không dùng "*" vì allowCredentials = true.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Hibernate & Seed dữ liệu mẫu (dev) ----------
# Đặt "validate" sau khi đã chạy hết script SQL migration ở production.
# Lần đầu chạy trên DB trống, đặt APP_SEED_ENABLED=true và APP_SEED_DEFAULT_PASSWORD=<mật khẩu dev>
# để tự đổ dữ liệu mẫu. Cùng một cờ này bật CẢ HAI bộ seed, chạy theo thứ tự:
#   1) DataInitializer     -> 2 Course + 10 admin (bảng ntt_admins)
#   2) QbankDataInitializer-> 5 môn × 3 chương × 100 câu = 500 câu hỏi (ngân hàng câu hỏi)
# Bộ 2 tự bỏ qua nếu ntt_subjects đã có dữ liệu, nên chạy lại nhiều lần vô hại.
#
# Nếu KHÔNG muốn chạy Spring Boot mà vẫn muốn có 500 câu, nạp thẳng bằng SQL:
#   mysql -u root -p <ten_db> < be-web-admin/sql/2026-11-23-qbank-seed-500-cau.sql
JPA_DDL_AUTO=update
APP_SEED_ENABLED=false
APP_SEED_DEFAULT_PASSWORD=
# ---------- Server 2 (AI worker / Colab Ollama) ----------
# Để trống AI_WORKER_BASE_URL thì nút "Kiểm định AI" trả 503 AI_WORKER_NOT_CONFIGURED.
# AI_INTERNAL_TOKEN phải TRÙNG app.ai.security.internal-token khai ở server-ai-worker.
AI_WORKER_BASE_URL=
AI_INTERNAL_TOKEN=
