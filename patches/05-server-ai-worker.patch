+      max-concurrency: 3
+      enabled: ${AI_NODE_3_ENABLED:true}
+    - name: colab-4
+      url: ${AI_NODE_4_URL:}
+      token: ${AI_NODE_4_TOKEN:}
+      max-concurrency: 3
+      enabled: ${AI_NODE_4_ENABLED:true}
+    - name: colab-5
+      url: ${AI_NODE_5_URL:}
+      token: ${AI_NODE_5_TOKEN:}
+      max-concurrency: 3
+      enabled: ${AI_NODE_5_ENABLED:true}
+
+  orchestrator:
