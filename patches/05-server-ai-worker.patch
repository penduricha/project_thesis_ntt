+  # (dừng nhận việc mới, chờ xong hoặc trả task về pending) trong thời gian lifecycle bên dưới.
+  shutdown: graceful
+  forward-headers-strategy: native
+  tomcat:
+    threads:
+      max: 20
+      min-spare: 5
+    max-connections: 1000
+    accept-count: 20
+
+gg:
+  jte:
+    developmentMode: false
+
+spring:
+  config:
+    import: "optional:file:.env[.properties]"
+  application:
+    name: server-ai-worker
+
+  # Phải lớn hơn ai.llm.read-timeout (120s) để một lần gọi Colab đang chạy kịp kết thúc hoặc requeue sạch.
+  lifecycle:
+    timeout-per-shutdown-phase: 150s
+
+  data:
+    redis:
+      host: ${IP_ADDRESS:127.0.0.1}
+      port: ${REDIS_PORT:6379}
+      username: ${REDIS_USERNAME:default}
+      password: ${REDIS_PASSWORD:}
+      database: ${REDIS_DBS:0}
+      connect-timeout: 2000ms
+      # Lettuce áp dụng timeout này cho cả lệnh chặn BRPOP; giữ ai.orchestrator.queue-block (5s) nhỏ hơn 10s.
+      timeout: 10s
+
+  datasource:
+    url: jdbc:mariadb://${IP_ADDRESS:127.0.0.1}:${MARIADB_PORT:3306}/${MARIADB_DBS:ntt_demo_llm}
+    username: ${MARIADB_USERNAME:root}
+    password: ${MARIADB_PASSWORD:}
+    driver-class-name: org.mariadb.jdbc.Driver
+    hikari:
+      connection-timeout: 5000
+      idle-timeout: 300000
+      max-lifetime: 900000
+      minimum-idle: 5
+      maximum-pool-size: 10
+      pool-name: HikariPool-Fast
+      auto-commit: true
+      leak-detection-threshold: 20000
+
+  jpa:
+    open-in-view: false
+    hibernate:
+      # Đang giữ "update" để test độc lập trên ntt_demo_llm (Hibernate tự tạo 3 bảng AI).
+      # Khi ghép vào DB chính đã chạy script ER v4: đổi thành "validate" hoặc "none"
+      # và đặt ai.demo.seed-issue-types=false.
+      ddl-auto: ${JPA_DDL_AUTO:update}
+    show-sql: false
+    properties:
+      hibernate:
+        format_sql: false
+        jdbc:
+          time_zone: UTC
+          batch_size: 50
+        order_inserts: true
+        order_updates: true
+        cache:
+          use_second_level_cache: false
+          use_query_cache: false
+
+  docker:
+    compose:
+      enabled: false
+
+ai:
+  llm:
+    model: qwen2.5:14b-instruct-q4_K_M
+    prompt-version: v2
+    # zero | few | few_cot (E2 | E3 | E4)
+    question-check-mode: few_cot
+    few-shot-count: 3
+    # Tiền kiểm tất định ở backend (trùng phương án, lộ đáp án, câu dẫn/phương án rỗng)
+    rule-preflight: true
+    # Bật true nếu muốn LLM gợi ý thêm độ khó 1..5 vào suggested_difficulty
+    suggest-difficulty: false
+    connect-timeout: 5s
+    # Dưới ~125s (Proxy Read Timeout của Cloudflare)
+    read-timeout: 120s
+    keep-alive: 30m
+    allowed-host-suffixes:
+      - .trycloudflare.com
+    # Giữ num_ctx bằng nhau giữa hai loại task để Ollama không nạp lại mô hình.
+    question-check:
+      num-ctx: 4096
+      num-predict: 700
+      temperature: 0.0
+      seed: 42
+    nl-search:
+      num-ctx: 4096
+      num-predict: 350
+      temperature: 0.0
+      seed: 42
+
