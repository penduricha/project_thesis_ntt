+    const on = api.connected;
+    ['#nl-send', '#burst-send', '#q-send'].forEach(id => { $(id).disabled = !on; });
+    const ready = slots.filter(x => !x.dirty && (x.srv === 'IDLE' || x.srv === 'FULL')).length;
+    $('#demo-hint').textContent = !on
+      ? 'Kết nối Server AI và lưu ít nhất một node để thử.'
+      : ready === 0
+        ? 'Chưa có node sẵn sàng. Nhập URL và token ở trên, bấm Lưu.'
+        : ready + ' node sẵn sàng. Gửi task đơn lẻ hoặc burst để quan sát điều phối.';
+  }
+
+  function clip(text, n) {
+    const t = String(text == null ? '' : text).replace(/\s+/g, ' ').trim();
+    return t.length > n ? t.slice(0, n) + '…' : t;
+  }
+
+  function renderHighlightedField(rawText, start, end) {
+    const box = document.createElement('div');
+    box.className = 'span-preview';
+    if (typeof rawText !== 'string' || start == null || end == null || start < 0 || end <= start || end > rawText.length) {
+      box.textContent = rawText || '';
+      return box;
+    }
+    const before = document.createTextNode(rawText.slice(0, start));
+    const mark = document.createElement('mark');
+    mark.textContent = rawText.slice(start, end);
+    const after = document.createTextNode(rawText.slice(end));
+    box.append(before, mark, after);
+    return box;
+  }
+
+  function renderTasks(list) {
+    const box = $('#tasks');
+    box.textContent = '';
+    $('#tasks-empty').hidden = list.length > 0;
+    const counts = new Map();
+
+    list.forEach(t => {
+      if (t.status === 'succeeded' && t.node) counts.set(t.node, (counts.get(t.node) || 0) + 1);
+      const row = document.createElement('div');
+      row.className = 'task';
+
+      const top = document.createElement('div');
+      top.className = 'task-top';
+      const st = document.createElement('span');
+      st.className = 'st';
+      st.dataset.s = t.status;
+      st.textContent = STATUS_LABEL[t.status] || t.status;
+      top.appendChild(st);
+
+      const bits = [TYPE_LABEL[t.taskType] || t.taskType];
+      if (t.node) bits.push('node ' + t.node);
+      if (t.inferenceMs != null && t.status === 'succeeded') bits.push(t.inferenceMs + ' ms');
+      if (t.promptVersion) bits.push(t.promptVersion);
+      if (t.modelDigest) bits.push('sha256:' + t.modelDigest.slice(0, 8));
+      if (t.params && t.params.cache === 'hit') bits.push('cache hit');
+      if ((t.attemptCount || 1) > 1) bits.push('lần thử ' + t.attemptCount);
+      bits.forEach(b => { const sp = document.createElement('span'); sp.textContent = b; top.appendChild(sp); });
+
+      const sub = document.createElement('div');
+      sub.className = 'task-sub';
+      sub.textContent = clip((t.input && (t.input.query || t.input.stem)) || '', 160);
+      row.append(top, sub);
+
+      if (t.status === 'failed') {
+        const err = document.createElement('div');
+        err.className = 'task-res';
+        err.textContent = (t.errorCode || 'ERROR') + ': ' + (t.errorMessage || '');
+        row.appendChild(err);
+      } else if (t.status !== 'succeeded') {
+        const wait = document.createElement('div');
+        wait.className = 'task-res';
+        wait.textContent = t.status === 'pending' ? 'Đang chờ node rảnh…' : 'Đang xử lý…';
+        row.appendChild(wait);
+      } else if (t.taskType === 'nl_search') {
+        const res = document.createElement('div');
+        res.className = 'task-res';
+        const r = t.result || {};
+        const parts = Object.entries(r)
+          .filter(([, v]) => v !== null && v !== '' && !(Array.isArray(v) && v.length === 0))
+          .map(([k, v]) => k + '=' + (Array.isArray(v) ? '[' + v.join(', ') + ']' : v));
+        res.textContent = parts.join(' · ') || 'Không có điều kiện lọc.';
+        row.appendChild(res);
+      } else if (t.taskType === 'question_check') {
+        const r = t.result || {};
+        if (r.analysis) {
+          const abox = document.createElement('div');
+          abox.className = 'analysis-box';
+          const pred = r.analysis.predicted_answer || '?';
+          const matchTxt = r.analysis.matches_correct_label ? 'Khớp đáp án đề' : 'LỆCH ĐÁP ÁN ĐỀ';
+          abox.textContent = 'Blind-Solve tự giải: ' + pred + ' (' + matchTxt + ') — ' + (r.analysis.self_solve_reasoning || '');
+          row.appendChild(abox);
+        }
+
+        const suggs = Array.isArray(t.suggestions) && t.suggestions.length
+          ? t.suggestions
+          : (r.suggestions || []).map(x => ({
+              seqNo: x.seq_no, issueType: x.issue_type, severity: x.severity,
+              targetField: x.target_field, originalText: x.original_text,
+              spanStart: x.span_start, spanEnd: x.span_end,
+              proposedText: x.proposed_text, explanation: x.explanation
+            }));
+
+        if (!suggs.length) {
+          const ok = document.createElement('div');
+          ok.className = 'task-res';
+          ok.textContent = 'Kết quả: Không phát hiện lỗi (none).';
+          row.appendChild(ok);
+        } else {
+          const slist = document.createElement('div');
+          slist.className = 'sugg-list';
+          suggs.forEach(sg => {
+            const card = document.createElement('div');
+            card.className = 'sugg-card';
+
+            const head = document.createElement('div');
+            head.className = 'sugg-head';
+
+            const t1 = document.createElement('span');
+            t1.className = 'tag';
+            t1.dataset.type = sg.issueType;
+            t1.textContent = ISSUE_LABEL[sg.issueType] || sg.issueType;
+
+            const t2 = document.createElement('span');
+            t2.className = 'tag';
+            t2.dataset.sev = sg.severity;
+            t2.textContent = 'severity: ' + sg.severity;
+
+            const t3 = document.createElement('span');
+            t3.className = 'tag';
+            t3.textContent = 'field: ' + sg.targetField + (sg.spanStart != null ? ' [' + sg.spanStart + ':' + sg.spanEnd + ']' : '');
+
+            head.append(t1, t2, t3);
+            card.appendChild(head);
+
+            if (sg.spanStart != null && t.input && typeof t.input[sg.targetField] === 'string') {
+              card.appendChild(renderHighlightedField(t.input[sg.targetField], sg.spanStart, sg.spanEnd));
+            }
+            if (sg.proposedText != null) {
+              const prop = document.createElement('div');
+              prop.className = 'diff-line';
+              prop.textContent = 'Đề xuất thay: ' + sg.proposedText;
+              card.appendChild(prop);
+            }
+            const exp = document.createElement('div');
+            exp.textContent = sg.explanation || '';
+            card.appendChild(exp);
+            slist.appendChild(card);
+          });
+          row.appendChild(slist);
+        }
+      }
+
+      box.appendChild(row);
+    });
+
+    const dist = $('#dist');
+    dist.textContent = '';
+    if (counts.size) {
+      const lab = document.createElement('span');
+      lab.textContent = 'Đã xong theo node:';
+      dist.appendChild(lab);
+      [...counts.entries()].sort().forEach(([n, c]) => {
+        const chip = document.createElement('span');
+        chip.className = 'chip';
+        const name = document.createElement('span');
+        name.textContent = n;
+        const num = document.createElement('b');
+        num.textContent = String(c);
+        chip.append(name, num);
+        dist.appendChild(chip);
+      });
+    }
+  }
+
+  let tasksTimer = 0;
+  async function loadTasks() {
+    if (!api.connected) return;
+    try {
+      const list = await call('GET', '/web/ai/tasks', undefined, 8000);
+      const arr = Array.isArray(list) ? list : [];
+      renderTasks(arr);
+      const active = arr.some(t => t.status === 'pending' || t.status === 'running');
+      if (active && !tasksTimer) tasksTimer = setInterval(loadTasks, 2000);
+      if (!active && tasksTimer) { clearInterval(tasksTimer); tasksTimer = 0; }
+    } catch (e) {}
+  }
+
+  async function submitTask(button, path, body, okMessage) {
+    button.disabled = true;
+    try {
+      const r = await call('POST', path, body, 30000);
+      toast(okMessage(r));
+      await loadTasks();
+    } catch (e) {
+      toast(e.message, 'bad');
+    }
+    paintDemo();
+  }
+
+  function sendNl(evt) {
+    evt.preventDefault();
+    const q = $('#nl-query').value.trim();
+    if (!q) { toast('Nhập câu tìm kiếm.', 'bad'); return; }
+    submitTask($('#nl-send'), '/web/ai/tasks', { taskType: 'nl_search', query: q },
+      () => 'Đã gửi nl_search. Kết quả hiện bên dưới.');
+  }
+
+  function sendBurst(evt) {
+    evt.preventDefault();
+    const n = Number($('#burst-count').value);
+    submitTask($('#burst-send'), '/web/ai/tasks/burst', { count: n, taskType: 'nl_search' },
+      r => 'Đã gửi ' + (r && r.count != null ? r.count : n) + ' task cùng lúc.');
+  }
+
+  function sendQuestion(evt) {
+    evt.preventDefault();
+    const qIdRaw = $('#q-id').value.trim();
+    const qRevRaw = $('#q-rev').value.trim();
+    const payload = {
+      taskType: 'question_check',
+      questionId: qIdRaw ? Number(qIdRaw) : null,
+      questionRevisionId: qRevRaw ? Number(qRevRaw) : null,
+      subjectName: $('#q-subj').value.trim() || null,
+      topicName: $('#q-topic').value.trim() || null,
+      stem: $('#q-stem').value,
+      optionA: $('#q-a').value,
+      optionB: $('#q-b').value,
+      optionC: $('#q-c').value,
+      optionD: $('#q-d').value,
+      correctLabel: $('#q-ok').value
+    };
+    submitTask($('#q-send'), '/web/ai/tasks', payload,
+      () => 'Đã gửi question_check. Kết quả hiện bên dưới.');
+  }
+
+  function applyPreset(p) {
+    $('#q-subj').value = p.subj;
+    $('#q-topic').value = p.topic;
+    $('#q-stem').value = p.stem;
+    $('#q-a').value = p.a;
+    $('#q-b').value = p.b;
+    $('#q-c').value = p.c;
+    $('#q-d').value = p.d;
+    $('#q-ok').value = p.ok;
+  }
+
+  $('#preset-multi').addEventListener('click', () => applyPreset({
+    subj: 'Cơ sở dữ liệu', topic: 'Mô hình quan hệ & Khóa',
+    stem: 'Trong mô hình quan hệ, khóa chính (Primary Key) dùng để lam gì?',
+    a: 'Xác định duy nhất mỗi bộ trong quan hệ',
+    b: 'Lưu trữ toàn bộ mật khẩu hệ thống',
+    c: 'Xác định duy nhất từng dòng dữ liệu',
+    d: 'Tự động sao lưu ổ cứng', ok: 'A'
+  }));
+  $('#preset-key').addEventListener('click', () => applyPreset({
+    subj: 'Mạng máy tính', topic: 'Giao thức ứng dụng HTTP/REST',
+    stem: 'Giao thức HTTP không mã hóa mặc định sử dụng cổng (port) nào?',
+    a: '21', b: '22', c: '80', d: '443', ok: 'D'
+  }));
+  $('#preset-clean').addEventListener('click', () => applyPreset({
+    subj: 'Tiếng Anh TOEIC', topic: 'Part 5 - Ngữ pháp & Từ loại',
+    stem: 'The quarterly financial report will be reviewed ___ the board of directors next Monday.',
+    a: 'by', b: 'since', c: 'during', d: 'between', ok: 'A'
+  }));
+
+  const rack = $('#rack');
+  slots.forEach((_, i) => rack.appendChild(buildSlot(i)));
+
+  $('#api-base').value = 'http://localhost:8082/api';
+  try { $('#api-base').value = localStorage.getItem(BASE_KEY) || $('#api-base').value; } catch (e) {}
+
+  const paste = $('#paste');
+  paste.addEventListener('paste', () => {
+    setTimeout(() => { if (fillFromText(paste.value, $('#paste-target').value)) paste.value = ''; }, 0);
+  });
+  $('#paste-fill').addEventListener('click', () => {
+    if (fillFromText(paste.value, $('#paste-target').value)) paste.value = '';
+  });
+  $('#server-form').addEventListener('submit', connect);
+  $('#save-all').addEventListener('click', saveAll);
+  $('#copy-env').addEventListener('click', copyEnv);
+  $('#nl-form').addEventListener('submit', sendNl);
+  $('#burst-form').addEventListener('submit', sendBurst);
+  $('#q-form').addEventListener('submit', sendQuestion);
+
+  slots.forEach((_, i) => setFields(i));
+  paintAll();
+})();
+</script>
+</body>
+</html>
