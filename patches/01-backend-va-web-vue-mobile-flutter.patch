+/// lớp này chỉ là lớp vỏ tương thích (adapter) để code cũ gọi mà không phải sửa, tránh "hai nguồn sự thật".
+///
+/// <p>Token vẫn chỉ được lưu một lần, dưới cùng hai khóa, nên dữ liệu trên máy không đổi và người dùng
+/// đang đăng nhập không bị đăng xuất sau khi cập nhật app.
 class TokenStorage {
   TokenStorage({FlutterSecureStorage? storage})
-      : _storage = storage ?? const FlutterSecureStorage();
+      : _authStorage = AuthStorage(storage: storage);
 
-  static const String _accessTokenKey = 'access_token';
-  static const String _refreshTokenKey = 'refresh_token';
-
-  final FlutterSecureStorage _storage;
+  final AuthStorage _authStorage;
 
+  /// Ghi đè cặp token của phiên hiện tại. Không có adminId thì không tạo phiên mới
+  /// (phiên phải do [AuthStorage.saveSession] tạo sau khi đăng nhập thành công).
   Future<void> saveTokens(AuthTokens tokens) async {
-    await Future.wait([
-      _storage.write(key: _accessTokenKey, value: tokens.accessToken),
-      _storage.write(key: _refreshTokenKey, value: tokens.refreshToken),
-    ]);
+    final session = AuthStorage.cachedSession ?? await _authStorage.readSession();
+    if (session == null) return;
+    await _authStorage.saveSession(
+      session.withTokens(
+        accessToken: tokens.accessToken,
+        refreshToken: tokens.refreshToken,
+      ),
+    );
   }
 
-  /// Dùng cho chức năng auto login sau này. Trả về null nếu chưa có token.
+  /// Trả về null nếu chưa có phiên / thiếu một trong hai token.
   Future<AuthTokens?> readTokens() async {
-    final accessToken = await _storage.read(key: _accessTokenKey);
-    final refreshToken = await _storage.read(key: _refreshTokenKey);
-    if (accessToken == null || refreshToken == null) return null;
-    return AuthTokens(accessToken: accessToken, refreshToken: refreshToken);
+    final session = AuthStorage.cachedSession ?? await _authStorage.readSession();
+    if (session == null) return null;
+    return AuthTokens(
+      accessToken: session.accessToken,
+      refreshToken: session.refreshToken,
+    );
   }
 
-  /// Gọi khi đăng xuất.
-  Future<void> clearTokens() async {
-    await Future.wait([
-      _storage.delete(key: _accessTokenKey),
-      _storage.delete(key: _refreshTokenKey),
-    ]);
-  }
+  /// Gọi khi đăng xuất: dọn TOÀN BỘ phiên (adminId, tên, 2 token) chứ không chỉ token,
+  /// nếu không auto login sẽ đọc được adminId cũ mà không có token -> trạng thái nửa vời.
+  Future<void> clearTokens() => _authStorage.clearSession();
 }
diff --git a/app_mobile/lib/features/login/data/model/login_result.dart b/app_mobile/lib/features/login/data/model/login_result.dart
index 29ae0db04..acf58ef40 100644
