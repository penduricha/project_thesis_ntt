+    private String extractBearerToken(HttpServletRequest request) {
+        String header = request.getHeader(AUTH_HEADER);
+        if (header == null || !header.startsWith(BEARER_PREFIX)) {
+            return null;
+        }
+        String token = header.substring(BEARER_PREFIX.length()).trim();
+        return token.isEmpty() ? null : token;
+    }
+
+    private void authenticate(String token, HttpServletRequest request) {
+        // 1. Chữ ký + hạn
+        if (!tokenProvider.validateToken(token)) {
+            return;
+        }
+        // 2. Không cho refresh token (sống 30 ngày) dùng như access token
+        if (!tokenProvider.isAccessToken(token)) {
+            log.debug("Từ chối token không phải ACCESS trong header Authorization: {}", request.getRequestURI());
+            return;
+        }
+
+        Long adminId;
+        try {
+            adminId = tokenProvider.getAdminIdFromToken(token);
+        } catch (RuntimeException e) {
+            return;
+        }
+
+        // 3. Còn trong Redis = chưa bị thu hồi (đăng xuất / khóa tài khoản)
+        try {
+            if (!adminTokenService.findAdminAccessTokenByJwtToken(token)) {
+                log.debug("Access token không còn trong Redis (đã đăng xuất/thu hồi): admin={}", adminId);
+                return;
+            }
+        } catch (RedisBusyException | DataAccessException e) {
+            // Redis lỗi: KHÔNG cho qua (fail-closed). Thà trả 401 để client làm mới token còn hơn để lọt
+            // request của một token đã bị thu hồi.
+            log.warn("Không kiểm tra được token trong Redis, từ chối request: {}", e.getMessage());
+            return;
+        }
+
+        // 4. Tài khoản phải còn dùng được. LOCKED / DISABLED bị chặn ngay tại đây, nên admin bị khóa
+        //    không thể tiếp tục dùng token đã cấp trước đó (trước đây trạng thái tài khoản không được đọc ở đâu cả).
+        Admin admin = adminRepository.findAdminByAdminId(adminId);
+        AccountStatus status = admin == null ? null : admin.getAccountStatus();
+        if (status == null || status == AccountStatus.LOCKED || status == AccountStatus.DISABLED) {
+            log.debug("Từ chối request của tài khoản không hoạt động: admin={}, status={}", adminId, status);
+            return;
+        }
+
+        // PENDING (chưa kích hoạt 2FA) chỉ có ROLE_PENDING: SecurityConfig giới hạn role này trong nhóm API
+        // thiết lập 2FA, nhờ vậy admin mới vẫn hoàn tất được việc bật 2FA mà không mở toàn bộ hệ thống.
+        String role = status == AccountStatus.ACTIVE ? "ROLE_ADMIN" : "ROLE_PENDING";
+
+        var authentication = new UsernamePasswordAuthenticationToken(
+                adminId, null, List.of(new SimpleGrantedAuthority(role)));
+        SecurityContextHolder.getContext().setAuthentication(authentication);
+        // Cho controller đọc adminId của CHÍNH MÌNH bằng @RequestAttribute("adminId") thay vì nhận ?adminId=
+        // từ client (nguồn gốc lỗi IDOR ở /web/admin/information/*).
+        request.setAttribute("adminId", adminId);
+    }
