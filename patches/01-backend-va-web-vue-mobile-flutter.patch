+package com.example.be_web_admin.security;
+
+import com.example.be_web_admin.security.jwt.user.AdminJwtTokenProvider;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.context.event.EventListener;
+import org.springframework.core.env.Environment;
+import org.springframework.stereotype.Component;
+
+import java.util.Arrays;
+
+/**
+ * Chặn khởi động khi chạy production mà vẫn dùng khóa ký JWT mặc định của môi trường dev.
+ *
+ * <p>Lý do: khóa từng bị hard-code trong mã nguồn và đã nằm trong Git. Nay khóa đọc từ {@code app.jwt.secret}
+ * (biến môi trường {@code JWT_SECRET}); nếu quên đặt biến này ở server thật, ứng dụng vẫn chạy với khóa ai cũng
+ * biết — kẻ tấn công tự ký token ADMIN cho bất kỳ adminId nào, bỏ qua cả mật khẩu lẫn TOTP. Thà không khởi động
+ * còn hơn chạy ở trạng thái đó.
+ *
+ * <p>Dùng {@code ApplicationReadyEvent} thay vì constructor để không phá các test đang dựng context một phần;
+ * khi phát hiện cấu hình sai thì ném lỗi và tiến trình dừng.
+ */
+@Slf4j
+@Component
+public class JwtSecretGuard {
+
+    private static final String DEFAULT_DEV_SECRET = "dev-only-secret-change-me-0123456789abcdef";
+
+    private final AdminJwtTokenProvider tokenProvider;
+    private final Environment environment;
+
+    public JwtSecretGuard(AdminJwtTokenProvider tokenProvider, Environment environment) {
+        this.tokenProvider = tokenProvider;
+        this.environment = environment;
+    }
+
+    @EventListener(ApplicationReadyEvent.class)
+    public void verifySecret() {
+        String secret = environment.getProperty("app.jwt.secret", "");
+        boolean isDevProfile = Arrays.stream(environment.getActiveProfiles())
+                .anyMatch(p -> p.equalsIgnoreCase("dev") || p.equalsIgnoreCase("test") || p.equalsIgnoreCase("local"));
+
+        if (tokenProvider.isUsingDefaultDevSecret() || DEFAULT_DEV_SECRET.equals(secret)) {
+            if (isDevProfile) {
+                log.warn("JWT đang dùng khóa mặc định của môi trường dev. KHÔNG dùng cấu hình này khi triển khai thật.");
+                return;
+            }
+            throw new IllegalStateException(
+                    "Thiếu biến môi trường JWT_SECRET: app.jwt.secret vẫn là khóa mặc định của môi trường dev. "
+                            + "Đặt JWT_SECRET (>= 32 ký tự, ví dụ: openssl rand -base64 48) rồi chạy lại.");
+        }
+        if (secret != null && secret.length() < 32) {
+            throw new IllegalStateException(
+                    "JWT_SECRET quá ngắn (" + secret.length() + " ký tự). HS256 cần khóa >= 32 byte.");
+        }
+    }
+}
