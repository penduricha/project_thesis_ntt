     }
 
     // Trường hợp 2a: mật khẩu đúng nhưng tài khoản đã bật 2FA mà mã không qua.
-    final twoFaMessage = _twoFaMessage(body);
-    if (twoFaMessage != null) return LoginRejected(twoFaMessage);
+    final twoFa = _twoFaRejection(body);
+    if (twoFa != null) return twoFa;
 
     // Trường hợp 2: sai Admin Id / mật khẩu hoặc server từ chối.
     return LoginRejected(_readString(body['message']) ?? _defaultRejectedMessage);
   }
 
-  /// data.code do server trả (cùng quy ước với Web): TOTP_REQUIRED | TOTP_INVALID | LOCKED.
-  String? _twoFaMessage(Map<String, dynamic> body) {
+  /// data.code do server trả (cùng quy ước với Web):
+  /// TOTP_REQUIRED | TOTP_INVALID | LOCKED | ACCOUNT_LOCKED | ACCOUNT_INACTIVE.
+  ///
+  /// Trả về [LoginRejected] kèm đúng `code` để màn hình đăng nhập chọn thông điệp + hành động phù hợp
+  /// (ví dụ TOTP_REQUIRED: mời kích hoạt lại trên Web; LOCKED: hiện đếm ngược).
+  LoginRejected? _twoFaRejection(Map<String, dynamic> body) {
     final data = body['data'];
     if (data is! Map<String, dynamic>) return null;
-    switch (data['code']) {
+    final code = _readString(data['code']);
+    if (code == null) return null;
+
+    final secs = data['retryAfterSeconds'];
+    final retryAfter = secs is num ? secs.toInt() : null;
+
+    switch (code) {
       case 'TOTP_REQUIRED':
-        return 'Two-factor authentication is on for this account, '
-            'but this device has no key for it.';
+        return const LoginRejected(
+          'Two-factor authentication is on for this account, but this device '
+          'has no key for it. Activate 2FA again on the web to get a new key, '
+          'then scan it in the Authenticator tab.',
+          code: 'TOTP_REQUIRED',
+        );
       case 'TOTP_INVALID':
-        return 'The code was rejected. The key on this device may be out of '
-            'date, or the code was just used. Wait a few seconds and try again.';
+        return const LoginRejected(
+          'The code was rejected. The key on this device may be out of date, '
+          'or the code was just used. Wait for the next code and try again.',
+          code: 'TOTP_INVALID',
+        );
       case 'LOCKED':
-        final secs = data['retryAfterSeconds'];
-        return secs is num
-            ? 'Too many wrong codes. Try again in ${secs.toInt()} seconds.'
-            : 'Too many wrong codes. Try again later.';
+        return LoginRejected(
+          retryAfter != null
+              ? 'Too many wrong codes. Try again in $retryAfter seconds.'
+              : 'Too many wrong codes. Try again later.',
+          code: 'LOCKED',
+          retryAfterSeconds: retryAfter,
+        );
+      case 'ACCOUNT_LOCKED':
+        return const LoginRejected(
+          'This account has been locked. Please contact the administrator.',
+          code: 'ACCOUNT_LOCKED',
+        );
+      case 'ACCOUNT_INACTIVE':
+        return const LoginRejected(
+          'This account is not activated yet or has been disabled. '
+          'Activate it on the web app first.',
+          code: 'ACCOUNT_INACTIVE',
+        );
     }
     return null;
   }
