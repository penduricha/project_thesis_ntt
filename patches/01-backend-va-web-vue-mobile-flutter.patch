@@ -14,10 +14,20 @@ final class LoginSuccess extends LoginResult {
 }
 
 /// Trường hợp 2: sai Admin Id hoặc mật khẩu (hoặc server từ chối vì lý do khác).
+///
+/// [code] giữ mã nghiệp vụ server trả trong data.code để tầng giao diện phân biệt được:
+///   - TOTP_REQUIRED  : đã bật 2FA nhưng MÁY NÀY không có khóa (cài lại app / xóa dữ liệu)
+///                      -> cần kích hoạt lại bằng mã khóa trên Web.
+///   - TOTP_INVALID   : có khóa trên máy nhưng mã bị từ chối (mã cũ / vừa dùng / lệch giờ).
+///   - LOCKED         : nhập sai mã quá nhiều lần, phải chờ.
+///   - ACCOUNT_LOCKED / ACCOUNT_INACTIVE : tài khoản bị khóa / chưa kích hoạt.
+/// Trước đây mọi trường hợp đều chỉ là một câu "Login failed", người dùng không biết phải làm gì.
 final class LoginRejected extends LoginResult {
-  const LoginRejected(this.message);
+  const LoginRejected(this.message, {this.code, this.retryAfterSeconds});
 
   final String message;
+  final String? code;
+  final int? retryAfterSeconds;
 }
 
 /// Trường hợp 3: mật khẩu đúng nhưng tài khoản đã đăng nhập ở thiết bị khác (HTTP 409).
