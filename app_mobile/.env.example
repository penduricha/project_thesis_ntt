# Chép file này thành .env (cp .env.example .env) rồi chỉnh cho máy của bạn.
# .env nằm trong .gitignore và được khai báo ở pubspec.yaml (assets) để flutter_dotenv đọc được.
# Sau khi sửa .env phải chạy lại hẳn (flutter run lại), hot reload không nạp lại asset.
# Asset .env có thể bị đọc từ ứng dụng đã build: KHÔNG đặt mật khẩu, token hay secret vào đây.
# Release yêu cầu SPRING_PROTOCOL=https và SPRING_HOST được cấu hình rõ; Android release chặn HTTP.
#
# Quy ước đường dẫn API (khớp Spring Boot):
#   Spring: context-path /api  +  @RequestMapping("/mobile/admin")
#   => URL đầy đủ  http://<host>:8080/api/mobile/admin/...
#   Flutter: SPRING_API_PREFIX = /api/mobile, các service chỉ ghi phần đuôi "/admin/...".
#   (Web Vue dùng nhánh còn lại: /api/web + "/admin/..." = /api/web/admin/...)

# ===== Máy chủ phát triển =====
# Android emulator thấy localhost của máy tính qua 10.0.2.2
HOST_ANDROID_EMULATOR=10.0.2.2
# iOS simulator / desktop / web
HOST_DEFAULT=localhost

# Điện thoại thật: điền IP LAN của máy tính (vd 192.168.1.10).
# Để trống = tự chọn theo nền tảng ở trên.
SPRING_HOST=
NODEJS_HOST=

# ===== Spring Boot =====
SPRING_PROTOCOL=http
SPRING_PORT=8080
SPRING_API_PREFIX=/api/mobile

# Basic Auth gửi lên Spring Boot (để trống nếu server không yêu cầu).
SPRING_AUTH_USERNAME=
SPRING_AUTH_PASSWORD=

# ===== Node.js =====
NODEJS_PROTOCOL=http
NODEJS_PORT=3000
NODEJS_API_PREFIX=/api/mobile

# ===== Thời gian chờ (giây) =====
CONNECT_TIMEOUT_SECONDS=10
SEND_TIMEOUT_SECONDS=15
RECEIVE_TIMEOUT_SECONDS=15
