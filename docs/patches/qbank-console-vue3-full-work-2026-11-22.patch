+.lmbar{position:sticky;bottom:calc(.75rem + env(safe-area-inset-bottom,0px));z-index:20;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;padding:.75rem 1rem;border:1px solid var(--border);border-radius:12px;background:var(--surface);box-shadow:0 8px 24px rgba(19,40,80,.14)}
+
+/* v8: hai thẻ đầu trang bằng chiều cao, hàng đầu và hàng cuối thẳng nhau */
+.lmhead>.card{height:100%}
+.lmhead .card__head{min-height:2rem}
+.lmhead p.mut{font-size:var(--fs-sm)}
+.lmhead input:not([type=checkbox]),.lmhead select,.lmhead .btn{min-height:2.75rem;font-size:1rem}
+.lmhead .btn{font-size:var(--fs-sm)}
+.lmhead .area{flex:1 1 auto;min-height:8.5rem;font-size:.8125rem}
+.lmhead .lmact{margin-top:auto}
+
+/* ===== v9: Cài đặt: một thẻ, mỗi mục một hàng (tiêu đề bên trái, điều khiển bên phải) ===== */
+.set{max-width:62rem;padding:0;gap:0}
+.set__row{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;padding:var(--space-3) var(--space-2)}
+.set__row+.set__row{border-top:1px solid var(--border)}
+.set__t{font-size:1.0625rem}
+.set__d{margin-top:.25rem;color:var(--text-muted);font-size:var(--fs-sm);line-height:1.5}
+.set__body{display:grid;gap:.35rem;min-width:0;align-content:start}
+.set__body>label{color:var(--text);font-weight:600}
+.set__body select{display:block;width:100%;max-width:22rem}
+.set__tfa{display:grid;gap:.75rem}
+.set .tfa{border-radius:var(--radius)}
+.sopt{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);padding:.875rem 0;color:var(--text);cursor:pointer}
+.sopt:first-child{padding-top:0}.sopt:last-child{padding-bottom:0}
+.sopt+.sopt{border-top:1px solid var(--border)}
+.sopt__t{display:grid;gap:.15rem;min-width:0}.sopt__t b{font-weight:600}
+.sopt .sw{position:relative;flex:none;min-height:0}
